# ============================================================
# GhostAgent API Server — Environment Variables
# ============================================================
# For Vercel: add these in Settings > Environment Variables
# For local dev: copy to .env (never commit .env to git)

# ─── DATABASE (Required) ────────────────────────────────────
# Neon PostgreSQL (recommended — works on Vercel)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ─── SERVER ──────────────────────────────────────────────────
PORT=8080

# ─── 0G NETWORK — Unlocks real on-chain features ─────────────
# Wallet private key (0x...) — enables 0G Storage + 0G Chain registration
# Get testnet funds at: https://faucet.0g.ai
ZEROG_PRIVATE_KEY=0x_your_wallet_private_key

# 0G Compute — AI inference (get from https://compute-marketplace.0g.ai)
ZEROG_COMPUTE_ENDPOINT=https://api.0g.compute.xyz/v1
ZEROG_COMPUTE_API_KEY=your_0g_compute_api_key

# 0G Compute model (optional — default: llama-3.1-70b-instruct)
# ZEROG_COMPUTE_MODEL=llama-3.1-70b-instruct
